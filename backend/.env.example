# ============================================================
# 咸鱼小市场 · 后端环境变量模板
# 用法：复制本文件为 backend/.env 后按需修改：
#     cp .env.example .env
# 优先级：进程环境变量 > .env 文件。shell 里 export 的会覆盖 .env。
# ============================================================

# ---------- 服务监听（IP / 端口） ----------
# 0.0.0.0 = 局域网手机/其他设备也能访问；仅本机调试可改 127.0.0.1
SALTED_FISH_HOST=0.0.0.0
SALTED_FISH_PORT=8000
# 1 = 改代码自动重启（仅开发）；生产置 0
SALTED_FISH_RELOAD=1
# CORS 允许来源，逗号分隔（默认 *，一般无需改）
# SALTED_FISH_CORS_ORIGINS=*

# ---------- 运行模式 ----------
# 1 = 演示模式（登录填昵称即算注册，无需真实微信），比赛/测试用
# 0 = 真实模式（走微信 jscode2session），需配下面的 WECHAT_APPID
SALTED_FISH_DEMO=1

# ---------- 数据库 ----------
# 默认使用 backend/ 下的 SQLite 文件（相对当前工作目录）
SALTED_FISH_DB=salted_fish.db
# 也可指定完整 SQLite；换成 PostgreSQL/MySQL 需装对应驱动（未内置）
# DATABASE_URL=sqlite:///./salted_fish.db

# ---------- 图片上传 ----------
# 上传图片存放目录（相对 backend/）
SALTED_FISH_UPLOAD_DIR=uploads

# ---------- 内容治理（举报 / 管理员）----------
# 这些昵称（演示模式）或 openid（真实模式）登录后自动成为「管理员」，可进后台处理举报/下架。
# 演示模式登录昵称即 openid，直接填想要的管理员昵称即可，逗号分隔。
ADMIN_OPENIDS=管理员

# ---------- 微信登录（真实模式） ----------
# SALTED_FISH_DEMO=0 时必需；留空则真实登录直接报"未配置"
WECHAT_APPID=
WECHAT_APP_SECRET=
# 登录签名令牌密钥：务必换成长随机串（生产绝不保留默认值）
SALTED_FISH_TOKEN_SECRET=change-me-to-a-random-secret

# 独立后台登录用的 RSA 私钥文件路径（首次登录自动生成；私钥切勿外泄/入库）
# ADMIN_RSA_KEY_PATH=/绝对路径/keys/admin_rsa.pem

# ---------- 订阅消息（家长确认）----------
# 1 = mock（消息落库到"家长通知"收件箱，比赛演示用）
# 0 = 真实调用微信订阅消息接口（需上面 appid/secret 及模板）
WECHAT_MOCK=1
# 订阅消息模板 id（真实模式下需要）
WECHAT_TEMPLATE_ID=

# ---------- 接口限流 ----------
# 1 = 开启登录/上传/AI 估价限流；测试可置 0
SALTED_FISH_RATE_LIMIT=1

# ---------- AI 视觉估值（遗留兜底，可忽略）----------
# 正式用法：admin-web「大模型管理」配模型 + 打开「AI 估值」。
# 代码优先读数据库 LLM；仅当库里没有任何启用模型时，才用下面 .env。
AI_VISION_ENABLED=0
AI_VISION_BASE_URL=https://api.openai.com/v1
AI_VISION_API_KEY=
AI_VISION_MODEL=gpt-4o-mini