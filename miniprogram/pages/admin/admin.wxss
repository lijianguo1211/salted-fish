.page-head { padding: 24rpx 28rpx 8rpx; }
.head-title { font-size: 40rpx; font-weight: 800; color: #2B4A42; }
.head-sub { font-size: 24rpx; color: #B0A69C; margin-top: 6rpx; }

.card {
  background: #fff; margin: 20rpx 24rpx; padding: 24rpx;
  border-radius: 20rpx;
}
.rep-top { display: flex; justify-content: space-between; align-items: center; }
.rep-title { font-size: 32rpx; font-weight: 700; color: #2B4A42; }
.rep-status {
  background: #E7F6F0; color: #54C7A5;
  font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx;
}
.chip { display: inline-block; }
.rep-meta { font-size: 24rpx; color: #8b7f75; margin-top: 10rpx; }
.rep-reason { font-size: 28rpx; color: #46635A; margin-top: 12rpx; }
.rep-note { font-size: 26rpx; color: #8b7f75; background: #F0FBF7; padding: 12rpx; border-radius: 10rpx; margin-top: 10rpx; }
.rep-time { font-size: 22rpx; color: #A8BFB6; margin-top: 14rpx; }
.rep-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.rep-actions button { flex: 1; font-size: 28rpx; }

.btn-outline {
  background: #fff; color: #54C7A5; border: 1rpx solid #54C7A5;
  border-radius: 999rpx; padding: 16rpx 0; font-weight: 600;
}
.btn-outline::after { border: none; }
.btn-danger {
  background: #FF5A5A; color: #fff; border-radius: 999rpx;
  padding: 16rpx 0; font-weight: 600;
}
.btn-danger::after { border: none; }

.empty { text-align: center; color: #B0A69C; padding-top: 120rpx; font-size: 26rpx; }
.empty-emoji { font-size: 64rpx; margin-bottom: 16rpx; }

/* ---- 分段切换 ---- */
.tabs {
  display: flex; gap: 12rpx; padding: 20rpx 24rpx 0;
}
.seg-item {
  flex: 1; text-align: center; padding: 18rpx 0;
  border-radius: 16rpx; font-size: 28rpx; font-weight: 600;
  color: #8FA49C; background: #fff; position: relative;
}
.seg-item.active { background: #54C7A5; color: #fff; }
.seg-badge {
  position: absolute; top: -8rpx; right: -6rpx;
  background: #FF5A5A; color: #fff; font-size: 20rpx;
  min-width: 32rpx; height: 32rpx; line-height: 32rpx;
  border-radius: 999rpx; padding: 0 8rpx;
}

/* ---- 分类管理 ---- */
.cat-head { display: flex; justify-content: space-between; align-items: center; }
.add-cat-btn { width: auto; padding: 12rpx 24rpx; font-size: 26rpx; border-radius: 999rpx; }
.cat-item { display: flex; align-items: center; gap: 20rpx; }
.cat-idx {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #E7F6F0; color: #54C7A5;
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 26rpx; flex-shrink: 0;
}
.cat-main { flex: 1; min-width: 0; }
.cat-name { font-size: 30rpx; font-weight: 700; color: #2B4A42; }
.cat-name .chip { margin-left: 12rpx; font-size: 20rpx; }
.chip.ok { background: #E7F6F0; color: #54C7A5; }
.chip.off { background: #F0EAE0; color: #8A9B85; }
.cat-meta { font-size: 24rpx; color: #A8BFB6; margin-top: 6rpx; }
.cat-ops { display: flex; gap: 12rpx; flex-shrink: 0; }
.cat-ops .btn-outline, .cat-ops .btn-danger { font-size: 24rpx; padding: 8rpx 20rpx; }
.btn-outline.sm, .btn-danger.sm { border-radius: 999rpx; }

/* ---- 分类表单弹层 ---- */
.mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  display: flex; align-items: flex-end; z-index: 60;
}
.sheet {
  background: #fff; width: 100%; border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx 48rpx; box-sizing: border-box;
}
.sheet-title { font-size: 32rpx; font-weight: 800; text-align: center; margin-bottom: 24rpx; }
.form-row { display: flex; align-items: center; padding: 16rpx 0; }
.form-label { width: 180rpx; font-size: 28rpx; color: #46635A; }
.form-input {
  flex: 1; background: #F0FBF7; border-radius: 14rpx;
  padding: 16rpx 20rpx; font-size: 28rpx;
}
.form-input.num { width: 160rpx; flex: none; }
.switch-row .form-label { width: 180rpx; }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.sheet-actions button { flex: 1; border-radius: 999rpx; }