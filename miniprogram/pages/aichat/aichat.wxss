.aichat-page {
  min-height: 100vh;
  background: #f2faf6;
  padding-bottom: 140rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 快捷问题 */
.quick { padding: 40rpx 32rpx; }
.quick-title { font-size: 30rpx; font-weight: 700; color: #2B4A42; margin-bottom: 20rpx; }
.quick-item {
  background: #fff; border-radius: 16rpx; padding: 22rpx 26rpx;
  margin-bottom: 16rpx; font-size: 28rpx; color: #46635A;
  border: 1rpx solid #E7F6F0;
}

/* 对话流 */
.msg-list {
  flex: 1;
  padding: 24rpx 28rpx;
}
.msg { display: flex; margin-bottom: 24rpx; }
.msg-me { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; }
.bubble {
  max-width: 76%;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  line-height: 1.6;
  border-radius: 20rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.msg-me .bubble { background: #54C7A5; color: #fff; border-bottom-right-radius: 4rpx; }
.msg-ai .bubble {
  background: #fff; color: #2B4A42;
  border-bottom-left-radius: 4rpx;
  border: 1rpx solid #E7F6F0;
}
.typing { color: #9AB8AD; }

/* 输入区 */
.input-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; padding: 16rpx 24rpx;
  box-shadow: 0 -6rpx 20rpx rgba(0,0,0,0.05);
  display: flex; align-items: center;
}
.chat-input {
  flex: 1; background: #F0FBF7; border-radius: 999rpx;
  padding: 18rpx 28rpx; font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx; background: #54C7A5; color: #fff;
  font-size: 28rpx; border-radius: 999rpx; padding: 0 36rpx;
  line-height: 2.4;
}
.send-btn::after { border: none; }