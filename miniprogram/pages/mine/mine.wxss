.profile {
  background: linear-gradient(135deg, #D8F3E9, #FFD978);
  display: flex; align-items: center; padding: 40rpx 32rpx;
}
.avatar.big {
  width: 110rpx; height: 110rpx; border-radius: 50%;
  background: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 60rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.p-info { flex: 1; margin-left: 24rpx; }
.p-name { font-size: 36rpx; font-weight: 800; }
.logout { margin-top: 12rpx; display: inline-block; font-size: 22rpx; padding: 4rpx 24rpx; }
.coin-panel { text-align: center; }
.coin-num { font-size: 44rpx; font-weight: 800; color: #54C7A5; }
.coin-label { font-size: 22rpx; color: #4E8F7C; }

.rule-row { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #E7F6F0; }
.rule-action { font-size: 28rpx; }
.rule-delta { font-weight: 700; }
.plus { color: #54C7A5; }
.minus { color: #E5484D; }
.rule-note { margin-top: 16rpx; line-height: 1.7; }

.my-item { display: flex; align-items: center; padding: 16rpx 0; }
.m-emoji {
  width: 80rpx; height: 80rpx; background: #E7F6F0; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.m-info { flex: 1; margin: 0 16rpx; }
.m-name { font-size: 28rpx; font-weight: 600; margin-bottom: 6rpx; }
.m-empty { color: #B0A69C; padding: 24rpx 0; text-align: center; }

.ledger-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #E7F6F0; }
.l-info {}
.l-note { font-size: 27rpx; margin-bottom: 6rpx; }
.l-delta { font-weight: 700; font-size: 30rpx; }
/* 管理员入口 */
.admin-entry {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 4rpx; color: #54C7A5; font-weight: 600; font-size: 28rpx;
}
.arrow { color: #A9C0B6; font-size: 32rpx; }
