.gate-wrap {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #E8F8F1 0%, #F7FCF9 40%, #F7FCF9 100%);
}
.gate-hero { margin-bottom: 48rpx; }
.gate-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A3D32;
  margin-bottom: 12rpx;
}
.gate-sub {
  font-size: 26rpx;
  color: #6B7C75;
  line-height: 1.5;
}
.gate-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 2rpx solid #E8F3EE;
  box-shadow: 0 8rpx 24rpx rgba(84, 199, 165, 0.08);
}
.gate-card.primary {
  border-color: #54C7A5;
  background: linear-gradient(135deg, #F3FBF7, #FFFFFF);
}
.gate-emoji { font-size: 56rpx; line-height: 1; }
.gate-body { flex: 1; min-width: 0; }
.gate-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A3D32;
  margin-bottom: 8rpx;
}
.gate-desc {
  font-size: 24rpx;
  color: #6B7C75;
  line-height: 1.45;
}
.gate-arrow {
  font-size: 40rpx;
  color: #54C7A5;
  font-weight: 300;
}
