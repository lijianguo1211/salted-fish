<view class="publish-page">
  <!-- 照片 -->
  <view class="card">
    <view class="title">📷 给闲置拍张照</view>
    <view class="photo-row">
      <view class="photo {{imgs.length?'':'photo-empty'}}" wx:for="{{imgs}}" wx:key="index">
        <image class="photo-img" src="{{item}}" mode="aspectFill" data-index="{{index}}"
               bindtap="previewPhoto" />
        <view class="photo-del" data-index="{{index}}" catchtap="delPhoto">×</view>
      </view>
      <view class="photo-add" wx:if="{{imgs.length < 3}}" bindtap="choosePhoto">＋</view>
    </view>
    <view class="muted tip">最多 3 张 · 展示成色，交换更顺手</view>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="title">📝 基本信息</view>
    <input class="input" placeholder="物品名称，例如：闪耀奥特曼卡 HR"
           value="{{name}}" bindinput="onName" />
    <view class="ai-fill-row">
      <button class="ai-fill-btn" size="mini" loading="{{aiFilling}}" disabled="{{aiFilling}}"
              bindtap="aiFill">🤖 AI 帮我填</button>
      <text class="muted ai-fill-tip">自动识别分类和成色</text>
    </view>
    <picker mode="selector" range="{{cats}}" value="{{catIndex}}" bindchange="onCat">
      <view class="picker">类别：{{cats[catIndex]||'请选择'}} ▾</view>
    </picker>
    <view class="conditions">
      <text class="cond {{condition===c?'cond-on':''}}" wx:for="{{conditions}}" wx:key="*this"
            bindtap="setCondition" data-c="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 估值：AI 参考 + 我自己估 -->
  <view class="card" wx:if="{{name}}">
    <view class="title space-between" wx:if="{{aiPricingEnabled}}">
      <text>🤖 AI 估值参考</text>
      <view class="val-btn" wx:if="{{!aiResult}}" bindtap="aiEstimate">一键估价</view>
      <view class="val-btn val-ing" wx:elif="{{aiResult}}">已估值</view>
    </view>
    <view class="ai-result" wx:if="{{aiResult}}">
      <view class="ai-num">🐟 {{aiResult.suggested_coins}}</view>
    </view>
    <view class="ai-expl" wx:if="{{aiResult}}">{{aiResult.explanation}}</view>
    <view class="title {{aiPricingEnabled ? 'title-gap' : ''}}">🙋 我自己估</view>
    <view class="muted tip">给同学看的参考枚数，可和 AI 估值不一样</view>
    <view class="stepper">
      <view class="step-btn" bindtap="decCoins">−</view>
      <view class="step-num">🐟 {{coins}}</view>
      <view class="step-btn" bindtap="incCoins">＋</view>
    </view>
  </view>

  <view class="card" wx:if="{{aiModerationEnabled}}">
    <view class="title">🛡️ AI 合规检测</view>
    <view class="muted tip">平台已开启上架合规检测，不宜学生的违法违规物品将被自动拦截。</view>
  </view>

  <!-- 想换什么 -->
  <view class="card">
    <view class="title">🔄 我想换</view>
    <input class="input" placeholder="例如：任何奥特曼卡 / 恐龙绘本 / 都行"
           value="{{wantTagsText}}" bindinput="onWant"/>
    <view class="muted tip">填多个用顿号（、）分隔</view>
  </view>

  <!-- 提交 -->
  <view class="submit-bar">
    <button class="btn-primary" bindtap="submit">上架闲置 ＋2 咸鱼币</button>
  </view>
</view>