.rank-head {
  background: linear-gradient(135deg, #E0F3EA, #BFEADD);
  padding: 40rpx 32rpx;
}
.rank-title { font-size: 40rpx; font-weight: 800; color: #248F74; }
.rank-sub { font-size: 24rpx; color: #4E8F7C; margin-top: 12rpx; line-height: 1.6; }

.podium {
  display: flex; align-items: flex-end; justify-content: center;
  padding: 36rpx 20rpx 8rpx; gap: 16rpx;
}
.pod { display: flex; flex-direction: column; align-items: center; flex: 1; }
.pod-medal { font-size: 50rpx; }
.pod-avatar {
  width: 90rpx; height: 90rpx; border-radius: 50%; background: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  margin-top: 8rpx;
}
.pod-avatar.big { width: 110rpx; height: 110rpx; font-size: 60rpx; }
.pod-name { font-size: 24rpx; margin-top: 10rpx; font-weight: 600; }
.pod-coins { font-size: 26rpx; color: #54C7A5; font-weight: 700; margin-top: 6rpx; }
.pod-bar {
  width: 100%; background: #F2D48F; border-radius: 16rpx 16rpx 0 0; margin-top: 14rpx;
}
.pod-1 .pod-bar { background: #FFB300; }

.list { padding: 20rpx 24rpx; box-sizing: border-box; }
.row-item {
  display: flex; align-items: center; padding: 20rpx;
  background: #fff; border-radius: 16rpx; margin-bottom: 14rpx;
}
.row-item.me { background: #E7F6F0; border: 2rpx solid #C9EBDE; }
.rank-num { width: 60rpx; font-weight: 800; font-size: 32rpx; color: #96ADA4; }
.avatar {
  width: 70rpx; height: 70rpx; border-radius: 50%; background: #E7F6F0;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.r-info { flex: 1; margin-left: 20rpx; }
.r-name { font-size: 28rpx; font-weight: 600; margin-bottom: 4rpx; }

.foot-note {
  text-align: center; color: #B0A69C; font-size: 22rpx; padding: 30rpx;
}
.empty { text-align: center; padding: 80rpx; color: #9A8F86; }